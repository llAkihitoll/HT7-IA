# Modelo de los agentes: con NVIDIA_API_KEY se usa NVIDIA NIM (como en los
# evals de HT6); si está vacía, se usa OPENAI_API_KEY.
NVIDIA_API_KEY=
# Modelo en NVIDIA NIM; vacío usa openai/gpt-oss-20b.
AGENT_MODEL=
OPENAI_API_KEY=sk-your-key-here
# Modelo opcional; si está vacío se conserva el predeterminado del SDK.
OPENAI_MODEL=
# Servidor MCP (Streamable HTTP) con las herramientas de los agentes.
MCP_HOST=127.0.0.1
MCP_PORT=8001
MCP_SERVER_URL=http://127.0.0.1:8001/mcp
# PostgreSQL de HT7: puerto distinto al 5432 de HT4 y 5433 de HT5.
POSTGRES_PORT=5434
POSTGRES_DB=parachute_faqs
POSTGRES_USER=parachute
POSTGRES_PASSWORD=parachute_local
# connect_timeout: si PostgreSQL no está levantado, buscar_faq falla en
# segundos en lugar de esperar el timeout por defecto de la conexión.
DATABASE_URL=postgresql://parachute:parachute_local@localhost:5434/parachute_faqs?connect_timeout=5
FAQ_FILE=data/Corpus_FAQs_Parachute_SA_2026.txt
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
SEARCH_MIN_SIMILARITY=0.35
BOOKINGS_DB=data/bookings.sqlite3
